    "preview": "vite preview",
    "test:e2e": "node e2e/auth-shell.spec.mjs",
    "pretest:e2e": "npm run build && node e2e/build-bin.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "^1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
