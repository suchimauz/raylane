{
  "name": "raylane-web",
  "version": "0.0.0-scaffold",
  "private": true,
  "type": "module",
  "description": "Raylane Web UI — build scaffold (inert, no product behaviour).",
  "license": "MIT",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
